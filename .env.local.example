# 開発・接続テスト用の環境変数。値の取得場所は README「環境変数」を参照。
# このファイルは .gitignore 済み。チャットやコミットに貼り付けないこと。
# 記入後: npm run check:connections

# --- Supabase ---
# Project Settings > Data API > Project URL（例: https://abcdefghijklmnop.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings > API Keys > anon public（または Publishable key: sb_publishable_...）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API Keys > service_role（または Secret key: sb_secret_...）
# サーバー専用。絶対に NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Beds24（接続テスト・物件登録用）---
# 本番では物件ごとの認証情報を property_secrets（DB）に保存する。ここは1物件分のテスト用。
# Beds24 管理画面 Settings > Marketplace > API > Invite code（1回限り）。
# 記入して npm run beds24:setup を実行すると BEDS24_REFRESH_TOKEN に交換され、この行は空に戻る
BEDS24_INVITE_CODE=
BEDS24_REFRESH_TOKEN=
# Beds24 の物件 ID（Settings > Properties の Property ID）
BEDS24_PROPERTY_ID=
# 任意: 予約取得テストに使う実在の予約番号
BEDS24_TEST_BOOKING_ID=
# Beds24 の予約 Webhook（/api/webhooks/beds24/<物件ID>）の認証用。32文字以上のランダムな文字列。
# Beds24 の Webhook 設定で、ヘッダー Authorization: Bearer <この値> を付けて送らせる
BEDS24_WEBHOOK_SECRET=

# --- LINE Messaging API（接続テスト・物件登録用）---
# 本番では物件ごとに property_secrets（DB）に保存する。ここは1物件分のテスト用。
# LINE Developers > チャネル > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Developers > チャネル > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=
# 任意: push 送信テストの宛先。チャネル基本設定 > あなたのユーザーID（U から始まる33文字）
# 送信は npm run check:connections -- --send-line を付けたときだけ行う
LINE_TEST_USER_ID=

# --- Stripe ---
# Stripe Dashboard > Developers > API keys の Secret key
STRIPE_SECRET_KEY=
# Stripe Dashboard > Developers > Webhooks の Signing secret
# Webhook の URL ではなく、実際の signing secret を入れること
STRIPE_WEBHOOK_SECRET=
# 段階制（graduated）料金: 1物件 11,000円 / 2〜5物件は一律 5,500円を追加（合計 16,500円）
STRIPE_PRICE_ID=

# --- App ---
# LINE Webhook には https の公開 URL が必要（Vercel のデプロイ先、または ngrok 等のトンネル URL）
NEXT_PUBLIC_APP_URL=http://localhost:3000
# --- メール（Resend）---
# 名簿登録の案内・鍵番号のメール送信用。https://resend.com/api-keys
RESEND_API_KEY=
# 送信元。Resend で認証済みのドメインのアドレス（例: 民泊コンシェルジュ <noreply@example.com>）
LOCK_CODE_EMAIL_FROM=

# 定期実行（/api/cron/lock-delivery、毎日 9:00 JST にチェックイン1週間前になった予約の鍵番号送信と失敗分の再送）の認証用。
# 32文字以上のランダムな文字列。Vercel の環境変数にも同じ値を設定すると、Vercel Cron が自動で付けて呼び出す
CRON_SECRET=
# LP の「無料で試してみる」「問い合わせ」ボタンのリンク先（問い合わせフォームの URL など）
NEXT_PUBLIC_CONTACT_URL=
